body {
  margin: 0;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ffc1cc, #ffdde1);
  font-family: 'Comic Sans MS', cursive, sans-serif;
  text-align: center;
  color: #333;
  overflow: hidden;
}

#container {
  max-width: 600px;
  padding: 20px;
}

#reason-img {
  width: 100%;
  max-height: 300px;
  object-fit: cover;
  border-radius: 15px;
  margin: 20px 0;
  display: none;
}

#reason-text {
  font-size: 1.5rem;
  display: none;
}

#click-hint {
  font-size: 1rem;
  color: #555;
  animation: blink 1.5s infinite;
}

@keyframes blink {
  50% { opacity: 0.5; }
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>10 Reasons Why You Should Date Me</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div id="container">
    <h1 id="title">10 Reasons Why You Should Date Me 💕</h1>
    <div id="content">
      <img id="reason-img" src="" alt="">
      <p id="reason-text"></p>
    </div>
    <p id="click-hint">Click anywhere to begin 💘</p>
  </div>

  <script src="script.js"></script>
</body>
</html>
